{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/prak7.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/pesanan/list.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/anggota/list.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/anggota/tambah.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/anggota/proses_tambah.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/anggota/edit.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/anggota/proses_edit.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/prak7/assets/:path*", "destination": "/prak7/assets/:path*" },
    { "source": "/prak7/:path*", "destination": "/api/prak7.php" },
    { "source": "/prak8/", "destination": "/api/index.php" },
    { "source": "/prak8/index.php", "destination": "/api/index.php" },
    { "source": "/prak8/anggota/:path*", "destination": "/api/anggota/:path*" },
    { "source": "/prak8/pesanan/:path*", "destination": "/api/pesanan/:path*" },
    { "source": "/index.php", "destination": "/api/index.php" },
    { "source": "/pesanan/:path*", "destination": "/api/pesanan/:path*" },
    { "source": "/anggota/:path*", "destination": "/api/anggota/:path*" }
  ]
}
