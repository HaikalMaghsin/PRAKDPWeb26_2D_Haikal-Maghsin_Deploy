{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/prak7.php": { "runtime": "vercel-php@0.9.0" },
    "api/prak8.php": { "runtime": "vercel-php@0.9.0" },
    "api/prak9.php": { "runtime": "vercel-php@0.9.0" },
    "api/prak10.php": { "runtime": "vercel-php@0.9.0" }
  },
  "routes": [
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/prak7/assets/(.*)$", "dest": "/prak7/assets/$1" },
    { "src": "^/prak7(?:/.*)?$", "dest": "/api/prak7.php" },
    { "src": "^/prak8(?:/.*)?$", "dest": "/api/prak8.php" },
    { "src": "^/prak9(?:/.*)?$", "dest": "/api/prak9.php" },
    { "src": "^/prak10(?:/.*)?$", "dest": "/api/prak10.php" },
    { "src": "^/(?:index\\.php|anggota/.*|pesanan/.*)$", "dest": "/api/prak8.php" },
    { "src": "^/api/.*$", "status": 404 },
    { "handle": "filesystem" },
    { "src": "/.*", "status": 404 }
  ]
}
